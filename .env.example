# =============================================================================
# BookEasy — Environment Variables
# =============================================================================
# Copy the values into Vercel → Project → Settings → Environment Variables.
# IMPORTANT: paste raw values WITHOUT surrounding quotes and with no trailing
# spaces/newlines (a quoted URL like "https://..." breaks the build).
#
# Legend:  [REQUIRED] app won't work without it   [OPTIONAL] feature degrades gracefully
# =============================================================================


# --- Core ---------------------------------------------------------------------

# [REQUIRED] Postgres (Supabase). Use the TRANSACTION pooler (port 6543) for
# serverless, with these query params, or Vercel will exhaust connections.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# [REQUIRED] Public base URL of the deployment (no trailing slash).
NEXTAUTH_URL=https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# [REQUIRED] Random 32+ byte secret. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# [OPTIONAL] Branding
NEXT_PUBLIC_APP_NAME=BookEasy


# --- Google OAuth + Calendar  [REQUIRED for Google login & calendar sync] -----
# console.cloud.google.com → APIs & Services → Credentials → OAuth client.
# Authorized redirect URI must be:
#   https://your-app.vercel.app/api/auth/callback/google
# Enable the "Google Calendar API" for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# --- Email (Resend)  [REQUIRED for confirmations, magic-link login, invites] --
# resend.com → API Keys. Verify a domain to send to ANY address; the shared
# onboarding@resend.dev only delivers to your own account email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=BookEasy <onboarding@resend.dev>


# --- SMS / reminders (Twilio)  [OPTIONAL] -------------------------------------
# twilio.com → Console. Without these, SMS reminders & waitlist texts are
# silently skipped (email still works).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15550000000

# [OPTIONAL] Secret to protect the reminder cron endpoint (any random string).
# The Vercel cron calls /api/cron/reminders with this as a Bearer token.
CRON_SECRET=


# --- Payments (Stripe)  [OPTIONAL] --------------------------------------------
# dashboard.stripe.com. Without these, the app runs free-only and the billing
# UI just shows "not configured" if clicked.
STRIPE_SECRET_KEY=
# After creating a webhook (see below), paste its signing secret here.
STRIPE_WEBHOOK_SECRET=

# Subscription plan Price IDs — create 3 recurring products/prices in Stripe.
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=

# -----------------------------------------------------------------------------
# Stripe one-time setup checklist:
#  1. Webhook endpoint:  https://your-app.vercel.app/api/webhooks/stripe
#     Enable events: checkout.session.completed,
#                    customer.subscription.created/updated/deleted,
#                    account.updated
#  2. Copy the webhook signing secret → STRIPE_WEBHOOK_SECRET
#  3. Enable "Connect" (Express) so hosts can receive booking payments.
# -----------------------------------------------------------------------------
